{
  "name": "dsh-moongate",
  "version": "0.6.3",
  "description": "DeepSeek Harness 自动审批门控：Flash 判定、确认制学习、信任目录与规则库。",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "scripts": {
    "test": "node --check src/index.mjs && node --check client.js && node scripts/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "approval",
    "审批",
    "自动审批"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suiyideali/dsh-moongate.git"
  },
  "homepage": "https://github.com/suiyideali/dsh-moongate",
